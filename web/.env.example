# Copy to .env.local for development. Vite only exposes VITE_-prefixed values, and it
# inlines them at build time: changing one needs a rebuild, not just a restart.
#
# These three are the only values that reach the browser. Every AI, search and
# service-role credential belongs to the API (api/.env), never here.

# The API origin (no trailing slash, no path).
# Production: https://qobo-support-api.onrender.com
# Development: omit to use http://localhost:8080
VITE_API_BASE_URL=

# Supabase project used for sign-in and sign-up. Must be the same project the API
# verifies tokens against, or every authenticated request comes back 401.
VITE_SUPABASE_URL=

# The project's PUBLISHABLE key (sb_publishable_...). A secret key (sb_secret_...) is
# rejected at startup, and `npm run build` fails if one reaches the bundle.
VITE_SUPABASE_PUBLISHABLE_KEY=
