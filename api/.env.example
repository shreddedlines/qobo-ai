# Copy to `.env` for local development. Never commit real values.

NODE_ENV=development
PORT=8080
LOG_LEVEL=info
# Reverse-proxy hops in front of the API (0 locally, 1 on Render)
TRUST_PROXY_HOPS=0
# Comma-separated browser origins allowed to call the API (exact origins, no trailing slash)
CORS_ORIGINS=http://localhost:5173

# Supabase — Project Settings → API Keys (use the new key format, not legacy anon/service_role)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server-only. Bypasses RLS — never expose to the browser.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Google Gemini (billing-enabled key)
GEMINI_API_KEY=
GEMINI_ROUTER_MODEL=gemini-3.5-flash-lite
GEMINI_ANSWER_MODEL=gemini-3.7-flash
# Used when the answer model is overloaded (503), rate limited (429) or slow; empty disables
GEMINI_ANSWER_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Tavily web search
TAVILY_API_KEY=

# Abuse and cost controls
USER_DAILY_MESSAGE_CAP=50
WEB_SEARCH_DAILY_CAP=100
# Per-IP limits: all API routes / chat message route
API_RATE_LIMIT_PER_MINUTE=120
CHAT_RATE_LIMIT_PER_MINUTE=20

# Knowledge-base build only (npm run ingest:build) — local machine, never set on Render.
# Supabase → Connect → Session pooler connection string
DATABASE_URL=
# Supabase → Database settings → SSL configuration → Download certificate
DATABASE_CA_CERT_PATH=
# Embedding quota guard (Gemini free tier: 100 embedding requests/minute; each text counts)
GEMINI_EMBED_REQUESTS_PER_MINUTE=90
GEMINI_EMBED_BATCH_SIZE=20
