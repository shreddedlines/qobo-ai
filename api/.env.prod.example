# Knowledge-base build against the PRODUCTION Supabase project (npm run ingest:build:prod).
# Local only — never set on the server.
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# qobo-prod → Connect → Session pooler connection string
DATABASE_URL=
# qobo-prod → Database settings → SSL configuration → Download certificate
DATABASE_CA_CERT_PATH=
GEMINI_EMBED_REQUESTS_PER_MINUTE=90

# Also lets `npm run ingest:verify:prod` check the production knowledge base
SUPABASE_URL=https://your-prod-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxx
